{
  "name": "code-reviewer",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/agent.ts"
  },
  "description": "AI code-review agent for pull requests (10xDevs M5L2/M5L3).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "review": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.140",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
