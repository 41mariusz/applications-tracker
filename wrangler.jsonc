{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "applications-tracker",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "triggers": {
    // Keepalive ping (src/worker.ts scheduled handler) so Supabase is not paused when idle.
    "crons": ["0 */6 * * *"],
  },
  "observability": {
    "enabled": true,
  },
}
