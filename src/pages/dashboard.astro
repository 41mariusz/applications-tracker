---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { listApplications } from "@/lib/services/applications";
import { logError } from "@/lib/log";
import { isProjectPaused } from "@/lib/supabase-paused";
import StatusControl from "@/components/applications/StatusControl";
import { isClosed } from "@/lib/domain/status";
import { matchesQuery, matchesStatus, parseStatusFilter } from "@/lib/domain/search";
import { formatDate } from "@/lib/format";
import { cn } from "@/lib/utils";
import { APPLICATION_STATUSES, STATUS_LABELS, type Application } from "@/types";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Button, buttonVariants } from "@/components/ui/button";
import { Input } from "@/components/ui/input";

const supabase = Astro.locals.supabase;
let applications: Application[] = [];
let loadError: string | null = null;
if (supabase) {
  try {
    applications = await listApplications(supabase);
  } catch (e) {
    if (isProjectPaused(e)) return Astro.redirect("/paused");
    logError(Astro, e, { op: "applications.list", status: 500 });
    loadError = "Nie udało się wczytać aplikacji.";
    // A failed read is a server error, not a page that merely looks empty.
    Astro.response.status = 500;
  }
}

// ?q= filters on the server too, so search works without JavaScript and links can be bookmarked.
// All cards are rendered; non-matching ones are hidden, so the in-page filter can widen the search.
const query = Astro.url.searchParams.get("q")?.trim() ?? "";
const selectedStatuses = parseStatusFilter(Astro.url.searchParams.getAll("status"));
const matches = new Set(
  applications.filter((a) => matchesQuery(a, query) && matchesStatus(a.status, selectedStatuses)).map((a) => a.id),
);
const filtering = query !== "" || selectedStatuses.length > 0;
// Status buttons show how many applications each status has (independent of the search).
const statusCounts = APPLICATION_STATUSES.map((s) => ({
  status: s,
  count: applications.filter((a) => a.status === s).length,
})).filter((c) => c.count > 0);
---

<Layout title="Moje aplikacje">
  <div class="bg-cosmic min-h-screen p-4 sm:p-8">
    <Topbar />
    <div class="text-foreground mx-auto max-w-3xl">
      <div class="mb-4 flex items-center justify-between gap-4">
        <h1 class="text-2xl font-bold">Moje aplikacje</h1>
        <a href="/applications/new" class:list={cn(buttonVariants(), "h-auto rounded-lg px-4 py-2")}>
          + Dodaj aplikację
        </a>
      </div>

      {loadError && (
        <Alert variant="destructive">
          <AlertDescription>{loadError}</AlertDescription>
        </Alert>
      )}

      {!loadError && applications.length === 0 && (
        <p class="border-border bg-card text-supporting-foreground rounded-xl border p-6 text-center">
          Nie masz jeszcze żadnych aplikacji. Dodaj pierwszą po wysłaniu CV.
        </p>
      )}

      {applications.length > 0 && (
        <form method="GET" class="mb-4" role="search" id="search-form">
          <label for="q" class="sr-only">
            Szukaj
          </label>
          <Input
            id="q"
            name="q"
            type="search"
            value={query}
            autoComplete="off"
            placeholder="Szukaj: firma, stanowisko, nazwisko lub telefon HR"
            className="bg-muted h-auto rounded-lg px-4 py-3 text-base md:text-base"
          />
          <fieldset class="mt-3 flex flex-wrap gap-2" data-testid="status-filter">
            <legend class="sr-only">Filtruj po statusie</legend>
            {statusCounts.map(({ status, count }) => (
              <label class="border-input bg-card text-supporting-foreground hover:bg-muted has-[:checked]:border-link has-[:checked]:bg-accent has-[:checked]:text-foreground cursor-pointer rounded-full border px-3 py-1 text-xs transition-colors select-none">
                <input
                  type="checkbox"
                  name="status"
                  value={status}
                  checked={selectedStatuses.includes(status)}
                  class="sr-only"
                />
                {STATUS_LABELS[status]} <span class="opacity-60">{count}</span>
              </label>
            ))}
            <noscript>
              <Button type="submit" size="sm" className="h-auto rounded-full px-3 py-1 text-xs">
                Filtruj
              </Button>
            </noscript>
          </fieldset>
          <p class="text-muted-foreground mt-2 text-xs" hidden={!filtering} id="search-summary">
            Wyniki: <span data-testid="search-count">{matches.size}</span>
          </p>
          <p class="text-supporting-foreground mt-2 text-sm" hidden={!filtering || matches.size > 0} id="search-empty">
            Brak wyników. Spróbuj fragmentu nazwy albo numeru albo zmień wybrane statusy.
          </p>
        </form>
      )}

      <ul class="space-y-3" data-testid="applications-list">
        {applications.map((a) => (
          <li
            class="border-border bg-muted rounded-xl border p-4 backdrop-blur-xl"
            data-status={a.status}
            data-testid={matches.has(a.id) ? "application-visible" : undefined}
            data-search={JSON.stringify({
              company: a.company,
              position: a.position,
              hr_contact_name: a.hr_contact_name,
              hr_contact_phone: a.hr_contact_phone,
            })}
            hidden={!matches.has(a.id)}
          >
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              {/* Closed: struck through and muted; the status control stays at full contrast (it reverts). */}
              <div class:list={[isClosed(a.status) && "text-muted-foreground line-through"]}>
                <a href={`/applications/${a.id}`} class="font-semibold hover:underline">
                  {a.company}
                </a>
                <p
                  class:list={["text-sm", isClosed(a.status) ? "text-muted-foreground" : "text-supporting-foreground"]}
                >
                  {a.position}
                  {a.applied_on && <span class="text-muted-foreground"> · {formatDate(a.applied_on)}</span>}
                </p>
              </div>
              <StatusControl applicationId={a.id} status={a.status} client:visible />
            </div>
            {(a.salary_range ?? a.quoted_rate) && (
              <p
                class:list={[
                  "mt-2 text-sm",
                  isClosed(a.status) ? "text-muted-foreground" : "text-supporting-foreground",
                ]}
              >
                {a.salary_range && <span>Widełki: {a.salary_range}</span>}
                {a.salary_range && a.quoted_rate && <span> · </span>}
                {a.quoted_rate && <span>Moja stawka: {a.quoted_rate}</span>}
              </p>
            )}
          </li>
        ))}
      </ul>
    </div>
  </div>
</Layout>

<script>
  // As-you-type filtering with the same rule the server uses for ?q=.
  import { matchesQuery, matchesStatus, type Searchable } from "@/lib/domain/search";
  import type { ApplicationStatus } from "@/types";

  const form = document.querySelector<HTMLFormElement>("#search-form");
  const input = document.querySelector<HTMLInputElement>("#q");
  const summary = document.querySelector<HTMLElement>("#search-summary");
  const empty = document.querySelector<HTMLElement>("#search-empty");
  const items = [...document.querySelectorAll<HTMLLIElement>("li[data-search]")].map((li) => ({
    li,
    data: JSON.parse(li.dataset.search ?? "{}") as Searchable,
    status: li.dataset.status as ApplicationStatus,
  }));
  const statusBoxes = [...document.querySelectorAll<HTMLInputElement>('input[name="status"]')];

  function selectedStatuses(): ApplicationStatus[] {
    return statusBoxes.filter((b) => b.checked).map((b) => b.value as ApplicationStatus);
  }

  function apply() {
    const query = input?.value ?? "";
    const statuses = selectedStatuses();
    let count = 0;
    for (const { li, data, status } of items) {
      const match = matchesQuery(data, query) && matchesStatus(status, statuses);
      li.hidden = !match;
      if (match) count++;
    }
    const active = query.trim() !== "" || statuses.length > 0;
    if (summary) {
      summary.hidden = !active;
      const counter = summary.querySelector("span");
      if (counter) counter.textContent = String(count);
    }
    if (empty) empty.hidden = !active || count > 0;
    // Keep the URL in sync so the current view can be bookmarked.
    const url = new URL(window.location.href);
    if (query.trim()) url.searchParams.set("q", query);
    else url.searchParams.delete("q");
    url.searchParams.delete("status");
    if (statuses.length > 0) url.searchParams.set("status", statuses.join(","));
    window.history.replaceState(null, "", url);
  }

  input?.addEventListener("input", apply);
  for (const box of statusBoxes) box.addEventListener("change", apply);
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    input?.blur();
  });
</script>
