---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
// Return path after sign-in (set by the middleware); the API checks it with safeNextPath.
const next = Astro.url.searchParams.get("next");
---

<Layout title="Logowanie">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent">
        Zaloguj się
      </h1>
      <SignInForm serverError={error} next={next} client:load />
    </div>
  </div>
</Layout>
