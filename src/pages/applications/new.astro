---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import ApplicationForm from "@/components/applications/ApplicationForm";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

// Inline text link: link variant without the button box (as on the details view).
const linkClass = cn(buttonVariants({ variant: "link" }), "h-auto p-0 font-normal");
---

<Layout title="Nowa aplikacja">
  <div class="bg-cosmic min-h-screen p-4 scheme-dark sm:p-8">
    <Topbar />
    <div class="text-foreground mx-auto max-w-2xl space-y-4">
      <a href="/dashboard" class:list={linkClass}>
        ← Moje aplikacje
      </a>
      <div class="bg-card rounded-xl border p-4 sm:p-6">
        <h1 class="mb-6 text-2xl font-bold">Nowa aplikacja</h1>
        <ApplicationForm client:load />
      </div>
    </div>
  </div>
</Layout>
