---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import ApplicationForm from "@/components/applications/ApplicationForm";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { buttonVariants } from "@/components/ui/button";
import { TRACKED_FIELDS } from "@/lib/domain/changes";
import type { ApplicationFormValues } from "@/lib/services/applications";
import { toServiceError } from "@/lib/services/errors";
import { isUuid } from "@/lib/domain/ids";
import { logError } from "@/lib/log";
import { isProjectPaused } from "@/lib/supabase-paused";
import { cn } from "@/lib/utils";
import type { Application } from "@/types";

const supabase = Astro.locals.supabase;
const id = Astro.params.id;
let application: Application | null = null;
let loadError: string | null = null;
// A malformed id cannot name an application: "not found" without asking the database.
if (supabase && isUuid(id)) {
  const { data, error, status } = await supabase
    .from("applications")
    .select("*")
    .eq("id", id)
    .maybeSingle<Application>();
  if (error) {
    const failure = toServiceError("application.edit.load", { error, status });
    if (isProjectPaused(failure)) return Astro.redirect("/paused");
    logError(Astro, failure, { op: "application.edit.load", entityId: id, status: 500 });
    loadError = "Nie udało się wczytać aplikacji.";
  }
  application = data;
}
// Unknown, foreign or malformed id → 404; a failed read → 500.
if (loadError) {
  Astro.response.status = 500;
} else if (!application) {
  Astro.response.status = 404;
}

// Form fields are strings; missing values become "".
const values = application
  ? (Object.fromEntries(TRACKED_FIELDS.map((f) => [f, application[f] ?? ""])) as ApplicationFormValues)
  : null;
// Inline text link: link variant without the button box (as on the details view).
const linkClass = cn(buttonVariants({ variant: "link" }), "h-auto p-0 font-normal");
---

<Layout title={application ? "Edytuj aplikację" : loadError ? "Aplikacja" : "Nie znaleziono"}>
  <div class="bg-cosmic min-h-screen p-4 scheme-dark sm:p-8">
    <Topbar />
    <div class="text-foreground mx-auto max-w-2xl space-y-4">
      <a href={application ? `/applications/${application.id}` : "/dashboard"} class:list={linkClass}>
        {application ? "← Szczegóły aplikacji" : "← Moje aplikacje"}
      </a>

      {loadError && (
        <Alert variant="destructive">
          <AlertDescription>{loadError}</AlertDescription>
        </Alert>
      )}
      {!application && !loadError && (
        <div class="bg-card rounded-xl border p-6 text-center" data-testid="not-found">
          <h1 class="text-lg font-semibold">Nie znaleziono</h1>
          <p class="text-supporting-foreground mt-1">Tej aplikacji nie ma albo link jest nieprawidłowy.</p>
          <a href="/dashboard" class:list={cn(buttonVariants({ size: "sm" }), "mt-4")}>
            Wróć do listy
          </a>
        </div>
      )}
      {application && values && (
        <div class="bg-card rounded-xl border p-4 sm:p-6">
          <h1 class="mb-6 text-2xl font-bold">Edytuj aplikację</h1>
          <ApplicationForm application={{ id: application.id, values }} client:load />
        </div>
      )}
    </div>
  </div>
</Layout>
