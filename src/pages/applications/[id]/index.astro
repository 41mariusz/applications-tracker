---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import StatusControl from "@/components/applications/StatusControl";
import NotesPanel from "@/components/applications/NotesPanel";
import CvPanel from "@/components/applications/CvPanel";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import { listCvFiles } from "@/lib/services/cv";
import type { CvFile } from "@/types";
import { createClient } from "@/lib/supabase";
import { latestActiveNote } from "@/lib/domain/notes";
import { FIELD_LABELS, mergeHistory, type HistoryField } from "@/lib/domain/changes";
import { isClosed } from "@/lib/domain/status";
import { formatDate, formatDateTime } from "@/lib/format";
import { getApplicationDetails, type ApplicationDetails } from "@/lib/services/notes";
import { EMPLOYMENT_TYPE_LABELS, NOTE_KIND_LABELS, STATUS_LABELS, WORK_MODE_LABELS } from "@/types";

const supabase = createClient(Astro.request.headers, Astro.cookies);
let details: ApplicationDetails | null = null;
let cvLibrary: CvFile[] = [];
let loadError: string | null = null;
if (supabase && Astro.params.id) {
  try {
    [details, cvLibrary] = await Promise.all([getApplicationDetails(supabase, Astro.params.id), listCvFiles(supabase)]);
  } catch (e) {
    // eslint-disable-next-line no-console -- server-side log for failed reads
    console.error("getApplicationDetails failed", e);
    loadError = "Nie udało się wczytać aplikacji.";
  }
}
if (!details && !loadError) {
  Astro.response.status = 404;
}

const application = details?.application;
const history = details ? mergeHistory(details.fieldChanges, details.statusChanges) : [];
const currentCv = cvLibrary.find((f) => f.id === details?.application.cv_file_id) ?? null;

// Show stored values the way the form shows them.
function displayValue(field: HistoryField, value: string | null): string {
  if (value === null || value === "") return "—";
  if (field === "employment_type") return EMPLOYMENT_TYPE_LABELS[value as keyof typeof EMPLOYMENT_TYPE_LABELS];
  if (field === "work_mode") return WORK_MODE_LABELS[value as keyof typeof WORK_MODE_LABELS];
  if (field === "applied_on") return formatDate(value);
  return value;
}
const latest = details ? latestActiveNote(details.notes) : null;
const phoneHref = application?.hr_contact_phone ? `tel:${application.hr_contact_phone.replace(/[^\d+]/g, "")}` : null;
// Inline text links: link variant without the button box.
const linkClass = cn(buttonVariants({ variant: "link" }), "h-auto p-0 font-normal");
---

<Layout title={application ? `${application.company} — ${application.position}` : "Aplikacja"}>
  <div class="bg-cosmic min-h-screen p-4 scheme-dark sm:p-8">
    <Topbar />
    <div class="text-foreground mx-auto max-w-2xl space-y-4">
      <a href="/dashboard" class:list={linkClass}>
        ← Moje aplikacje
      </a>

      {loadError && (
        <Alert variant="destructive">
          <AlertDescription>{loadError}</AlertDescription>
        </Alert>
      )}
      {!details && !loadError && (
        <p class="bg-card text-supporting-foreground rounded-xl border p-6 text-center">
          Nie znaleziono tej aplikacji.
        </p>
      )}

      {details && application && (
        <>
          {/* What is needed during a call comes first (PRD FR-006). */}
          <section class="bg-muted rounded-2xl border p-5 backdrop-blur-xl" data-testid="call-summary">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div class:list={["min-w-0", isClosed(application.status) && "line-through opacity-60"]}>
                <h1 class="text-xl font-bold break-words">{application.company}</h1>
                <p class="text-supporting-foreground break-words">{application.position}</p>
              </div>
              <StatusControl applicationId={application.id} status={application.status} client:load />
            </div>
            <dl class="mt-4 grid grid-cols-2 gap-3 text-sm">
              <div>
                <dt class="text-muted-foreground">Widełki</dt>
                <dd class="text-base font-semibold">{application.salary_range ?? "—"}</dd>
              </div>
              <div>
                <dt class="text-muted-foreground">Moja stawka</dt>
                <dd class="text-base font-semibold">{application.quoted_rate ?? "—"}</dd>
              </div>
            </dl>
            <div class="bg-card mt-4 rounded-lg p-3 text-sm">
              <p class="text-muted-foreground">Ostatnie ustalenie</p>
              {latest ? (
                <>
                  <p class="mt-1 break-words whitespace-pre-wrap">{latest.body}</p>
                  <p class="mt-1 text-xs text-muted-foreground">
                    {NOTE_KIND_LABELS[latest.kind]} · {formatDateTime(latest.noted_at)}
                  </p>
                </>
              ) : (
                <p class="mt-1 text-muted-foreground">Brak notatek.</p>
              )}
            </div>
            {(application.hr_contact_name ?? phoneHref) && (
              <p class="mt-3 text-sm break-words">
                <span class="text-muted-foreground">HR: </span>
                {application.hr_contact_name}
                {phoneHref && (
                  <>
                    {application.hr_contact_name && " · "}
                    <a href={phoneHref} class="text-link underline">
                      {application.hr_contact_phone}
                    </a>
                  </>
                )}
              </p>
            )}
          </section>

          <NotesPanel applicationId={application.id} notes={details.notes} client:load />

          <CvPanel applicationId={application.id} current={currentCv} library={cvLibrary} client:visible />

          <section class="bg-card rounded-xl border p-4 text-sm">
            <div class="mb-2 flex items-center justify-between">
              <h2 class="font-semibold">Szczegóły</h2>
              <a href={`/applications/${application.id}/edit`} class:list={linkClass}>
                Edytuj
              </a>
            </div>
            <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1">
              <dt class="text-muted-foreground">Ogłoszenie</dt>
              <dd class="truncate">
                {application.posting_url ? (
                  <a
                    href={application.posting_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-link underline"
                  >
                    {application.posting_url}
                  </a>
                ) : (
                  "—"
                )}
              </dd>
              <dt class="text-muted-foreground">Aplikowano</dt>
              <dd>{application.applied_on ? formatDate(application.applied_on) : "—"}</dd>
              <dt class="text-muted-foreground">Forma</dt>
              <dd>{application.employment_type ? EMPLOYMENT_TYPE_LABELS[application.employment_type] : "—"}</dd>
              <dt class="text-muted-foreground">Tryb</dt>
              <dd>{application.work_mode ? WORK_MODE_LABELS[application.work_mode] : "—"}</dd>
            </dl>
          </section>

          <section class="bg-card rounded-xl border p-4 text-sm" data-testid="history">
            <h2 class="mb-2 font-semibold">Historia zmian</h2>
            {history.length === 0 ? (
              <p class="text-muted-foreground">Bez zmian od dodania ({formatDateTime(application.created_at)}).</p>
            ) : (
              <ul class="space-y-1">
                {history.map((h) => (
                  <li class="break-words">
                    <span class="text-muted-foreground">{formatDateTime(h.at)}</span> ·{" "}
                    {h.type === "status" ? (
                      <>
                        Status: {STATUS_LABELS[h.from]} → {STATUS_LABELS[h.to]}
                        {h.is_revert && <span class="text-warning"> (cofnięcie)</span>}
                      </>
                    ) : (
                      <>
                        {FIELD_LABELS[h.field]}:{" "}
                        <span class="line-through opacity-70">{displayValue(h.field, h.old_value)}</span> →{" "}
                        {displayValue(h.field, h.new_value)}
                      </>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </section>
        </>
      )}
    </div>
  </div>
</Layout>
