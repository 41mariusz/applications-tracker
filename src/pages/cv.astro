---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import CvLibrary, { type CvLibraryEntry } from "@/components/applications/CvLibrary";
import { groupByCv } from "@/lib/domain/cv";
import { listApplications } from "@/lib/services/applications";
import { listCvFiles } from "@/lib/services/cv";
import { logError } from "@/lib/log";
import { isProjectPaused } from "@/lib/supabase-paused";
import { Alert, AlertDescription } from "@/components/ui/alert";

const supabase = Astro.locals.supabase;
// null when the read failed: the island then shows the upload box only.
let entries: CvLibraryEntry[] | null = [];
let loadError: string | null = null;
if (supabase) {
  try {
    const [files, applications] = await Promise.all([listCvFiles(supabase), listApplications(supabase)]);
    const groups = groupByCv(files, applications);
    entries = files.map((file) => ({
      file,
      applications: (groups.get(file.id) ?? []).map(({ id, company, position, status }) => ({
        id,
        company,
        position,
        status,
      })),
    }));
  } catch (e) {
    if (isProjectPaused(e)) return Astro.redirect("/paused");
    logError(Astro, e, { op: "cv.library", status: 500 });
    loadError = "Nie udało się wczytać biblioteki CV.";
    entries = null;
    Astro.response.status = 500;
  }
}
---

<Layout title="Biblioteka CV">
  <div class="bg-cosmic min-h-screen p-4 sm:p-8">
    <Topbar />
    <div class="text-foreground mx-auto max-w-3xl">
      <h1 class="mb-4 text-2xl font-bold">Biblioteka CV</h1>
      {loadError && (
        <Alert variant="destructive" className="mb-4">
          <AlertDescription>
            <p>
              {loadError}{" "}
              <a
                href="/cv"
                class="text-link focus-visible:ring-ring inline-flex min-h-10 items-center rounded-sm underline outline-none focus-visible:ring-2"
              >
                Odśwież
              </a>
            </p>
          </AlertDescription>
        </Alert>
      )}
      <CvLibrary entries={entries} client:load />
    </div>
  </div>
</Layout>
