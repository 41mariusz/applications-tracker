---
// Kitchen sink for the details view (/applications/[id]), the list (/dashboard) and the CV library (/cv): their
// components in the 7 states side by side.
// Dev only (404 in a production build) and not linked from the app. Islands render statically (no hydration);
// hover and focus-visible are forced by the screenshot script on elements marked data-ks="hover-target" /
// data-ks="focus-target". Token classes only.
import Layout from "@/layouts/Layout.astro";
import NotFound from "@/pages/404.astro";
import StatusControl, { STATUS_PILL_CLASS } from "@/components/applications/StatusControl";
import ApplicationCard from "@/components/applications/ApplicationCard.astro";
import { FILTER_CHIP_CLASS } from "@/components/applications/list-classes";
import NotesPanel from "@/components/applications/NotesPanel";
import CvPanel from "@/components/applications/CvPanel";
import ApplicationForm from "@/components/applications/ApplicationForm";
import {
  FORM_CONTROL_CLASS,
  FORM_ERROR_CLASS,
  FORM_LABEL_CLASS,
  FORM_TEXT_ACTION_CLASS,
} from "@/components/applications/form-classes";
import CvLibrary, { CvItem, type CvLibraryEntry } from "@/components/applications/CvLibrary";
import CvUploadBox, { CvUploadStatus } from "@/components/applications/CvUploadBox";
import { PreviewFallback } from "@/components/ErrorBoundary";
import ErrorText from "@/components/ErrorText";
import { errorMessage } from "@/lib/domain/client-errors";
import { cvFileUrl } from "@/lib/cv-urls";
import { cvAnchorId, CV_LIMITS_TEXT } from "@/lib/domain/cv";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Badge } from "@/components/ui/badge";
import { Button, buttonVariants } from "@/components/ui/button";
import { Card } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { NativeSelect, NativeSelectOption } from "@/components/ui/native-select";
import { Textarea } from "@/components/ui/textarea";
import { cn } from "@/lib/utils";
import { STATUS_LABELS, type Application, type CvFile, type Note } from "@/types";
import type { ApplicationFormErrors, ApplicationFormValues } from "@/lib/services/applications";

// Production builds answer 404 with the regular not-found page.
const enabled = import.meta.env.DEV;
if (!enabled) {
  Astro.response.status = 404;
}

const STATES = ["default", "hover", "focus-visible", "disabled", "error", "empty", "loading"] as const;

const buttonVariantsShown = ["default", "outline", "secondary", "ghost", "link", "destructive"] as const;

const appId = "00000000-0000-4000-8000-000000000001";
const sampleNotes: Note[] = [
  {
    id: "00000000-0000-4000-8000-000000000011",
    application_id: appId,
    kind: "phone_call",
    body: "Stawka 24k B2B zaakceptowana, start od 1 grudnia. Link: https://example.com/a/very/long/url/that/should/break/inside/the/card",
    noted_at: "2026-10-04T10:15:00.000Z",
    created_at: "2026-10-04T10:20:00.000Z",
    updated_at: "2026-10-04T12:00:00.000Z",
    deleted_at: null,
    revisions: [
      {
        id: "00000000-0000-4000-8000-000000000021",
        note_id: "00000000-0000-4000-8000-000000000011",
        previous_kind: "phone_call",
        previous_body: "Stawka 22k B2B.",
        previous_noted_at: "2026-10-04T10:15:00.000Z",
        changed_at: "2026-10-04T12:00:00.000Z",
      },
    ],
  },
  {
    id: "00000000-0000-4000-8000-000000000012",
    application_id: appId,
    kind: "comment",
    body: "Notatka usunięta — zostaje przekreślona na osi czasu.",
    noted_at: "2026-10-02T08:00:00.000Z",
    created_at: "2026-10-02T08:00:00.000Z",
    updated_at: "2026-10-03T08:00:00.000Z",
    deleted_at: "2026-10-03T08:00:00.000Z",
    revisions: [],
  },
];
const sampleCv: CvFile = {
  id: "00000000-0000-4000-8000-000000000031",
  file_name: "CV Anna Kowalska — senior frontend developer, wersja angielska.pdf",
  mime_type: "application/pdf",
  size_bytes: 248_000,
  created_at: "2026-09-30T09:00:00.000Z",
};
// Application list (/dashboard): an open card with an unbroken company name and a closed one.
const listBase = {
  user_id: "00000000-0000-4000-8000-000000000000",
  posting_url: null,
  hr_contact_name: "Jan Nowak",
  hr_contact_phone: "500-600-700",
  employment_type: null,
  work_mode: null,
  cv_file_id: null,
  last_activity_at: "2026-10-05T10:00:00.000Z",
  created_at: "2026-10-01T10:00:00.000Z",
  updated_at: "2026-10-05T10:00:00.000Z",
} satisfies Partial<Application>;
const openApplication: Application = {
  ...listBase,
  id: "00000000-0000-4000-8000-000000000041",
  company: "Przedsiębiorstwo-Informatyczno-Usługowe-Bardzo-Długa-Nazwa-Sp-z-o-o",
  position: "Senior Fullstack Developer (React, Node.js)",
  salary_range: "18 000 – 24 000 PLN netto/mies. na B2B",
  quoted_rate: "22 000 PLN",
  applied_on: "2026-10-01",
  status: "interviews",
};
const closedApplication: Application = {
  ...listBase,
  id: "00000000-0000-4000-8000-000000000042",
  company: "Globex Corporation",
  position: "Backend Engineer (Go)",
  salary_range: null,
  quoted_rate: "17k",
  applied_on: "2026-08-15",
  status: "rejected",
};
const bareApplication: Application = {
  ...listBase,
  id: "00000000-0000-4000-8000-000000000043",
  company: "Initech",
  position: "QA",
  salary_range: null,
  quoted_rate: null,
  applied_on: null,
  status: "sent",
};
const statusErrorMessage = errorMessage(
  { kind: "network", name: "TypeError", message: "Failed to fetch" },
  "Nie udało się zmienić statusu.",
);
// Browser failure states (src/lib/domain/client-errors.ts): a non-JSON server answer and the paused project.
const serverErrorMessage = errorMessage({ kind: "server", status: 503 }, "Nie udało się zapisać.");
const pausedMessage = errorMessage({ kind: "paused", status: 503 }, "Nie udało się zapisać.");
const otherCv: CvFile = { ...sampleCv, id: "00000000-0000-4000-8000-000000000032", file_name: "CV Anna.docx" };
// Application form (/applications/new, /applications/[id]/edit): edit values and the 400 field messages.
const formValues: ApplicationFormValues = {
  company: "Przedsiębiorstwo-Informatyczno-Usługowe-Bardzo-Długa-Nazwa-Sp-z-o-o",
  position: "Senior Fullstack Developer (React, Node.js)",
  posting_url: "https://example.com/oferty/senior-fullstack-developer-react-node",
  salary_range: "18 000 – 24 000 PLN netto/mies. na B2B",
  quoted_rate: "22 000 PLN",
  hr_contact_name: "Jan Nowak",
  hr_contact_phone: "500-600-700",
  applied_on: "2026-10-01",
  employment_type: "b2b",
  work_mode: "remote",
};
const formErrors: ApplicationFormErrors = {
  company: "Podaj nazwę firmy",
  position: "Podaj stanowisko",
  posting_url: "Podaj pełny adres, np. https://…",
};
// CV library (/cv): one item per optional variant. Each id is unique, so every item has its own `cv-<id>` anchor.
const usageOf = ({ id, company, position, status }: Application): CvLibraryEntry["applications"][number] => ({
  id,
  company,
  position,
  status,
});
const unusedCvEntry: CvLibraryEntry = {
  file: {
    ...sampleCv,
    id: "00000000-0000-4000-8000-000000000051",
    file_name: "CV_Anna_Kowalska_senior_frontend_developer_React_TypeScript_wersja_angielska_2026_final_v3.pdf",
  },
  applications: [],
};
const usedCvEntry: CvLibraryEntry = {
  file: { ...otherCv, id: "00000000-0000-4000-8000-000000000052" },
  applications: [usageOf(openApplication), usageOf(closedApplication)],
};
const collapsedCvEntry: CvLibraryEntry = {
  file: { ...sampleCv, id: "00000000-0000-4000-8000-000000000053", file_name: "CV Anna — krótkie.pdf" },
  applications: [usageOf(bareApplication)],
};
const uploadLabel = `Wgraj CV do biblioteki (${CV_LIMITS_TEXT}) — ten sam plik nie zapisze się drugi raz`;
const uploadErrorMessage = errorMessage(
  { kind: "network", name: "TypeError", message: "Failed to fetch" },
  "Nie udało się wgrać pliku.",
);
const ignoreFile = () => undefined;
// CvItem renders its own controls, so the hover/focus markers are set on them by a script below instead of
// widening the shared component with kitchen-sink props: [selector, marker].
const cvMarkers: [string, string][] = [
  [`#${cvAnchorId(unusedCvEntry.file.id)} button`, "hover-target"],
  [`#${cvAnchorId(collapsedCvEntry.file.id)} [data-testid="cv-usage"]`, "hover-target"],
  [`#${cvAnchorId(usedCvEntry.file.id)} ul > li:nth-child(2) > a`, "hover-target"],
  [`#${cvAnchorId(usedCvEntry.file.id)} button`, "focus-target"],
  [`#${cvAnchorId(usedCvEntry.file.id)} [data-testid="cv-usage"]`, "focus-target"],
  [`#${cvAnchorId(usedCvEntry.file.id)} ul > li:first-child > a`, "focus-target"],
];
---

{enabled ? (
  <Layout title="Kitchen sink">
    <div class="bg-cosmic text-foreground min-h-screen p-4 scheme-dark sm:p-8">
      <div class="mx-auto max-w-5xl space-y-6">
        <header>
          <h1 class="text-xl font-bold">Kitchen sink — szczegóły aplikacji</h1>
          <p class="text-muted-foreground text-sm">
            Stany: {STATES.join(" · ")}. „N/A” = stan nie dotyczy komponentu (powód obok).
          </p>
        </header>

        {/* Buttons: one row per variant, columns = states. */}
        <Card className="gap-3 rounded-xl p-4 shadow-none" data-ks="section-buttons">
          <h2 class="font-semibold">Button</h2>
          {buttonVariantsShown.map((variant) => (
            <div class="flex flex-wrap items-center gap-3 text-xs">
              <span class="text-muted-foreground w-20">
                {variant === "destructive" ? "destructive — nie używać (patrz CLAUDE.md)" : variant}
              </span>
              <Button variant={variant} size="sm">
                Default
              </Button>
              <Button variant={variant} size="sm" data-ks="hover-target">
                Hover
              </Button>
              <Button variant={variant} size="sm" data-ks="focus-target">
                Focus
              </Button>
              <Button variant={variant} size="sm" disabled>
                Disabled
              </Button>
              <Button variant={variant} size="sm" disabled>
                Zapisywanie…
              </Button>
            </div>
          ))}
          <p class="text-muted-foreground text-xs">error / empty: N/A — błąd pokazuje Alert lub tekst pod polem.</p>
        </Card>

        {/* Chips: status pill (Badge / select pill) and note-kind chips. */}
        <Card className="gap-3 rounded-xl p-4 shadow-none" data-ks="section-chips">
          <h2 class="font-semibold">Badge / chipy</h2>
          <div class="flex flex-wrap items-center gap-3 text-xs">
            <Badge variant="secondary">Kontakt HR</Badge>
            <Badge variant="outline">Odrzucona</Badge>
            <Button
              variant="outline"
              size="sm"
              role="radio"
              aria-checked="true"
              className="border-link bg-accent hover:bg-accent text-foreground hover:text-foreground h-auto rounded-full px-3 py-1 text-xs font-normal shadow-none"
            >
              Rozmowa (wybrany)
            </Button>
            <Button
              variant="outline"
              size="sm"
              role="radio"
              aria-checked="false"
              className="border-input bg-card hover:bg-muted text-foreground hover:text-foreground h-auto rounded-full px-3 py-1 text-xs font-normal shadow-none"
            >
              Komentarz
            </Button>
            <Button
              variant="outline"
              size="sm"
              data-ks="hover-target"
              className="border-input bg-card hover:bg-muted text-foreground hover:text-foreground h-auto rounded-full px-3 py-1 text-xs font-normal shadow-none"
            >
              Hover
            </Button>
            <Button
              variant="outline"
              size="sm"
              data-ks="focus-target"
              className="border-input bg-card hover:bg-muted text-foreground hover:text-foreground h-auto rounded-full px-3 py-1 text-xs font-normal shadow-none"
            >
              Focus
            </Button>
            <Button
              variant="outline"
              size="sm"
              disabled
              className="border-input bg-card text-foreground h-auto rounded-full px-3 py-1 text-xs font-normal shadow-none"
            >
              Disabled
            </Button>
          </div>
          <p class="text-muted-foreground text-xs">error / empty / loading: N/A — chip zawsze ma wartość.</p>
        </Card>

        {/* Fields: Input, Textarea, NativeSelect, Label. */}
        <Card className="gap-4 rounded-xl p-4 shadow-none" data-ks="section-fields">
          <h2 class="font-semibold">Input / Textarea / NativeSelect / Label</h2>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
            <div class="space-y-1">
              <Label htmlFor="ks-input-default">Default</Label>
              <Input id="ks-input-default" defaultValue="Acme sp. z o.o." className="bg-muted" />
            </div>
            <div class="space-y-1">
              <Label htmlFor="ks-input-focus">Focus</Label>
              <Input
                id="ks-input-focus"
                defaultValue="Fokus z klawiatury"
                className="bg-muted"
                data-ks="focus-target"
              />
            </div>
            <div class="space-y-1">
              <Label htmlFor="ks-input-disabled">Disabled</Label>
              <Input id="ks-input-disabled" defaultValue="Zablokowane" disabled className="bg-muted" />
            </div>
            <div class="space-y-1">
              <Label htmlFor="ks-input-error">Error</Label>
              <Input id="ks-input-error" defaultValue="" aria-invalid="true" className="bg-muted" />
              <p class="text-destructive text-xs">Podaj nazwę firmy</p>
            </div>
            <div class="space-y-1">
              <Label htmlFor="ks-input-empty">Empty</Label>
              <Input id="ks-input-empty" placeholder="Co zostało ustalone?" className="bg-muted" />
            </div>
            <div class="space-y-1">
              <Label htmlFor="ks-datetime">Kiedy</Label>
              <Input
                id="ks-datetime"
                type="datetime-local"
                defaultValue="2026-10-05T10:30"
                className="bg-muted w-auto"
              />
            </div>
            <div class="space-y-1">
              <Label htmlFor="ks-textarea">Textarea</Label>
              <Textarea id="ks-textarea" rows={3} placeholder="Co zostało ustalone?" className="bg-muted" />
            </div>
            <div class="space-y-1">
              <Label htmlFor="ks-textarea-focus">Textarea focus</Label>
              <Textarea
                id="ks-textarea-focus"
                rows={3}
                defaultValue="Ustalenia z rozmowy"
                className="bg-muted"
                data-ks="focus-target"
              />
            </div>
            <div class="space-y-1">
              <Label htmlFor="ks-textarea-error">Textarea error</Label>
              <Textarea id="ks-textarea-error" rows={3} aria-invalid="true" className="bg-muted" />
              <p class="text-destructive text-xs">Treść notatki nie może być pusta</p>
            </div>
            <div class="space-y-1">
              <Label htmlFor="ks-select">NativeSelect</Label>
              <NativeSelect id="ks-select" defaultValue="" wrapperClassName="w-full" className="bg-muted">
                <NativeSelectOption value="" disabled>
                  —
                </NativeSelectOption>
                <NativeSelectOption value="a">CV Anna.pdf (240 KB)</NativeSelectOption>
              </NativeSelect>
            </div>
            <div class="space-y-1">
              <Label htmlFor="ks-select-focus">NativeSelect focus</Label>
              <NativeSelect
                id="ks-select-focus"
                defaultValue=""
                wrapperClassName="w-full"
                className="bg-muted"
                data-ks="focus-target"
              >
                <NativeSelectOption value="" disabled>
                  —
                </NativeSelectOption>
              </NativeSelect>
            </div>
            <div class="space-y-1">
              <Label htmlFor="ks-select-disabled">NativeSelect disabled</Label>
              <NativeSelect
                id="ks-select-disabled"
                defaultValue=""
                disabled
                wrapperClassName="w-full"
                className="bg-muted"
              >
                <NativeSelectOption value="" disabled>
                  —
                </NativeSelectOption>
              </NativeSelect>
            </div>
          </div>
          <p class="text-muted-foreground text-xs">
            hover: N/A — pola nie zmieniają wyglądu po najechaniu. loading: N/A — w trakcie zapisu pole jest disabled.
          </p>
        </Card>

        {/* Card, Alert, empty and loading texts. */}
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <Card className="gap-2 rounded-xl p-4 text-sm shadow-none">
            <h2 class="font-semibold">Card</h2>
            <p class="text-supporting-foreground">Panel (bg-card) z tekstem pomocniczym.</p>
            <p class="text-muted-foreground text-xs">Etykieta / znacznik czasu (muted).</p>
            <p class="text-warning text-xs">(cofnięcie) — warning</p>
            <a
              href="#ks-link"
              class="text-link focus-visible:ring-ring rounded-sm underline outline-none focus-visible:ring-2"
              data-ks="focus-target"
            >
              Link (focus)
            </a>
          </Card>
          <div class="space-y-3">
            <Alert variant="destructive">
              <AlertDescription>Nie udało się wczytać aplikacji.</AlertDescription>
            </Alert>
            <Alert variant="destructive">
              <AlertDescription>Brak połączenia. Spróbuj ponownie.</AlertDescription>
            </Alert>
            <Alert variant="destructive" data-ks="server-error">
              <AlertDescription>
                <p>
                  <ErrorText message={serverErrorMessage} />
                </p>
              </AlertDescription>
            </Alert>
            <Alert variant="destructive" data-ks="paused">
              <AlertDescription>
                <p>
                  <ErrorText message={pausedMessage} />
                </p>
              </AlertDescription>
            </Alert>
            <PreviewFallback fileUrl={cvFileUrl(sampleCv.id)} />
          </div>
          <Card className="gap-2 rounded-xl p-4 text-sm shadow-none" data-ks="section-empty">
            <h2 class="font-semibold">Empty</h2>
            <p class="text-muted-foreground">Brak notatek.</p>
            <p class="text-muted-foreground">Nie dołączono CV.</p>
            <p class="text-muted-foreground">Bez zmian od dodania (5.10.2026, 10:30).</p>
            <p>—</p>
          </Card>
          <Card className="gap-2 rounded-xl p-4 text-sm shadow-none" data-ks="section-loading">
            <h2 class="font-semibold">Loading</h2>
            <p class="text-muted-foreground text-xs">Zapisywanie…</p>
            <p class="text-muted-foreground text-xs">Usuwanie…</p>
            <p class="text-muted-foreground text-xs">Wczytywanie podglądu…</p>
          </Card>
        </div>

        {/* Application list (/dashboard): the shared card plus the list's controls, in the 7 states. */}
        <section class="space-y-4" id="ks-list" data-ks="section-list">
          <h2 class="font-semibold">Lista aplikacji (/dashboard)</h2>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div class="space-y-1">
              <p class="text-muted-foreground text-xs">default — otwarta (nazwa bez spacji zawija się)</p>
              <ul>
                <ApplicationCard application={openApplication} visible hydrate={false} />
              </ul>
            </div>
            <div class="space-y-1">
              <p class="text-muted-foreground text-xs">
                default — zamknięta (przekreślona, status w pełnym kontraście)
              </p>
              <ul>
                <ApplicationCard application={closedApplication} visible hydrate={false} />
              </ul>
            </div>
            <div class="space-y-1">
              <p class="text-muted-foreground text-xs">default — bez widełek i stawki, bez daty</p>
              <ul>
                <ApplicationCard application={bareApplication} visible hydrate={false} />
              </ul>
            </div>
          </div>
          <Card className="gap-3 rounded-xl p-4 shadow-none">
            <p class="text-muted-foreground text-xs">
              hover / focus-visible — najedź albo przejdź Tabem (pierścień ring na chipie, linku, przycisku i
              wyszukiwarce).
            </p>
            <div class="flex flex-wrap items-center gap-2">
              <label class:list={FILTER_CHIP_CLASS} data-ks="hover-target">
                <input type="checkbox" class="sr-only" />
                Wysłana <span class="text-muted-foreground">3</span>
              </label>
              <label class:list={FILTER_CHIP_CLASS}>
                <input type="checkbox" class="sr-only" checked data-ks="focus-target" />
                Rozmowy <span class="text-muted-foreground">1</span>
              </label>
              <a
                href="#ks-list"
                class:list={cn(buttonVariants(), "h-auto rounded-lg px-4 py-2")}
                data-ks="focus-target"
              >
                + Dodaj aplikację
              </a>
            </div>
            <Input
              type="search"
              aria-label="Szukaj"
              placeholder="Firma, stanowisko, HR lub telefon"
              className="bg-muted h-auto rounded-lg px-4 py-3 text-base md:text-base"
              data-ks="focus-target"
            />
            <p class="text-muted-foreground text-xs">
              Wyniki: <span>12</span>
            </p>
          </Card>
          {/* StatusControl shows "Zapisywanie…" and its error line only after an interaction (internal state), so
              these two cards copy that markup around the shared STATUS_PILL_CLASS. Keep them in step with
              src/components/applications/StatusControl.tsx when it changes. */}
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <Card className="gap-2 rounded-xl p-4 text-sm shadow-none">
              <p class="text-muted-foreground text-xs">disabled — status w trakcie zapisu</p>
              <div class="flex flex-col items-start gap-1">
                <NativeSelect disabled aria-label="Zmień status" className={STATUS_PILL_CLASS}>
                  <NativeSelectOption value="">{STATUS_LABELS.interviews}</NativeSelectOption>
                </NativeSelect>
                <p class="text-muted-foreground text-xs">Zapisywanie…</p>
              </div>
            </Card>
            <Card className="gap-2 rounded-xl p-4 text-sm shadow-none">
              <p class="text-muted-foreground text-xs">error — odczyt listy i zmiana statusu</p>
              <Alert variant="destructive">
                <AlertDescription>Nie udało się wczytać aplikacji.</AlertDescription>
              </Alert>
              <p role="alert" class="text-destructive max-w-48 text-xs">
                <ErrorText message={statusErrorMessage} />
              </p>
            </Card>
            <Card className="gap-2 rounded-xl p-4 text-sm shadow-none">
              <p class="text-muted-foreground text-xs">empty — brak aplikacji / brak wyników</p>
              <p class="border-border bg-card text-supporting-foreground rounded-xl border p-6 text-center">
                Nie masz jeszcze żadnych aplikacji. Dodaj pierwszą po wysłaniu CV.
              </p>
              <p class="text-supporting-foreground text-sm">
                Brak wyników. Spróbuj fragmentu nazwy albo numeru albo zmień wybrane statusy.
              </p>
            </Card>
            <Card className="gap-2 rounded-xl p-4 text-sm shadow-none">
              <p class="text-muted-foreground text-xs">loading — N/A</p>
              <p class="text-supporting-foreground">
                Lista renderuje się na serwerze, bez pobierania w przeglądarce. Najbliższy stan to „Zapisywanie…”
                kontrolki statusu — pokazany w disabled.
              </p>
            </Card>
          </div>
        </section>

        {/* Application form: the real island rendered on the server (no client:), seeded through its kitchen-sink
            props (initialErrors, initialServerError, initialPending, initialQuotedRate). */}
        <section class="space-y-4" id="ks-form" data-ks="section-form">
          <h2 class="font-semibold">Formularz aplikacji (/applications/new, /applications/[id]/edit)</h2>
          <p class="text-muted-foreground text-xs">
            Render statyczny: wyspa nie jest hydratowana, więc „Zapisz” jest tu zawsze wyłączony (przed hydratacją
            formularz nie ma akcji). Włączony przycisk pokazuje sekcja Button i wiersz hover / focus-visible poniżej.
          </p>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <Card className="gap-2 rounded-xl p-4 shadow-none">
              <p class="text-muted-foreground text-xs">
                default / empty — nowa aplikacja (puste pola, dzisiejsza data)
              </p>
              <ApplicationForm />
            </Card>
            <Card className="gap-2 rounded-xl p-4 shadow-none">
              <p class="text-muted-foreground text-xs">default — edycja z wartościami (długa nazwa zawija się)</p>
              <ApplicationForm application={{ id: appId, values: formValues }} />
            </Card>
            <Card className="gap-2 rounded-xl p-4 shadow-none">
              <p class="text-muted-foreground text-xs">
                error — błędy pól (aria-invalid, komunikat role="alert") i Alert „Popraw zaznaczone pola.”
              </p>
              <ApplicationForm initialErrors={formErrors} />
            </Card>
            <Card className="gap-2 rounded-xl p-4 shadow-none">
              <p class="text-muted-foreground text-xs">error — błąd serwera (Alert nad przyciskami)</p>
              <ApplicationForm
                application={{ id: appId, values: formValues }}
                initialServerError={serverErrorMessage}
              />
            </Card>
            <Card className="gap-2 rounded-xl p-4 shadow-none">
              <p class="text-muted-foreground text-xs">
                disabled / loading — zapis w toku: „Zapisywanie…”, przycisk wyłączony, formularz aria-busy; pola zostają
                aktywne (wyłączonych FormData by nie wysłał). Szkielet ładowania: N/A — formularz nie pobiera danych w
                przeglądarce.
              </p>
              <ApplicationForm application={{ id: appId, values: formValues }} initialPending />
            </Card>
            <Card className="gap-2 rounded-xl p-4 shadow-none">
              <p class="text-muted-foreground text-xs">edycja — zmieniona stawka: pole „Dlaczego zmieniasz stawkę?”</p>
              <ApplicationForm application={{ id: appId, values: formValues }} initialQuotedRate="24 000 PLN" />
            </Card>
          </div>
          {/* Hover and focus-visible are forced on these copies built from the same form classes. */}
          <Card className="gap-3 rounded-xl p-4 shadow-none">
            <p class="text-muted-foreground text-xs">
              hover / focus-visible — te same klasy co formularz (form-classes.ts): pierścień ring na polu, liście,
              przycisku i „Anuluj”.
            </p>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
              <div>
                <Label htmlFor="ks-form-input-focus" className={FORM_LABEL_CLASS}>
                  Firma * (focus)
                </Label>
                <Input
                  id="ks-form-input-focus"
                  defaultValue="Acme sp. z o.o."
                  className={FORM_CONTROL_CLASS}
                  data-ks="focus-target"
                />
              </div>
              <div>
                <Label htmlFor="ks-form-select-focus" className={FORM_LABEL_CLASS}>
                  Tryb pracy (focus)
                </Label>
                <NativeSelect
                  id="ks-form-select-focus"
                  defaultValue=""
                  wrapperClassName="w-full"
                  className={FORM_CONTROL_CLASS}
                  data-ks="focus-target"
                >
                  <NativeSelectOption value="">—</NativeSelectOption>
                </NativeSelect>
              </div>
              <div>
                <Label htmlFor="ks-form-input-error" className={FORM_LABEL_CLASS}>
                  Stanowisko * (error + focus)
                </Label>
                <Input
                  id="ks-form-input-error"
                  aria-invalid="true"
                  aria-describedby="ks-form-input-error-message"
                  className={FORM_CONTROL_CLASS}
                  data-ks="focus-target"
                />
                <p id="ks-form-input-error-message" class:list={FORM_ERROR_CLASS}>
                  Podaj stanowisko
                </p>
              </div>
            </div>
            <div class="flex flex-wrap items-center gap-4">
              <Button size="lg" data-ks="hover-target">
                Zapisz (hover)
              </Button>
              <Button size="lg" data-ks="focus-target">
                Zapisz (focus)
              </Button>
              <a href="#ks-form" class:list={FORM_TEXT_ACTION_CLASS} data-ks="focus-target">
                Anuluj
              </a>
            </div>
          </Card>
        </section>

        {/* CV library (/cv): the real exported pieces (CvItem, CvLibrary, CvUploadBox, CvUploadStatus) in the
            7 states; the only copy is the failed-read banner, marked below. */}
        <section class="space-y-4" id="ks-cv-library" data-ks="section-cv-library">
          <h2 class="font-semibold">Biblioteka CV (/cv)</h2>
          <Card className="gap-1 rounded-xl p-4 text-xs shadow-none">
            <ul class="text-muted-foreground space-y-1">
              <li>
                default — pozycje poniżej (długa nazwa bez użycia, użycie rozwinięte z zamkniętą aplikacją, zwinięte).
              </li>
              <li>
                hover / focus-visible — data-ks na „Podgląd”, przełączniku „Podpięte do aplikacji” i linku aplikacji.
              </li>
              <li>disabled — wybór pliku w trakcie wgrywania.</li>
              <li>error — nieudany odczyt biblioteki (baner + samo pole wgrywania) i błąd wgrywania.</li>
              <li>empty — pusta biblioteka.</li>
              <li>
                loading — „Wgrywanie…” (karta disabled) i „Wczytywanie podglądu…” (karta Loading wyżej). Sama lista: N/A
                — renderuje się na serwerze, bez pobierania w przeglądarce.
              </li>
            </ul>
            <a
              href={`#${cvAnchorId(usedCvEntry.file.id)}`}
              class="text-link focus-visible:ring-ring inline-flex min-h-10 items-center rounded-sm underline outline-none focus-visible:ring-2"
            >
              Pokaż wyróżnienie po wgraniu
            </a>
          </Card>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div class="space-y-1">
              <p class="text-muted-foreground text-xs">default — długa nazwa bez spacji, bez użycia</p>
              <ul>
                <CvItem entry={unusedCvEntry} />
              </ul>
            </div>
            <div class="space-y-1">
              <p class="text-muted-foreground text-xs">default — użycie rozwinięte (otwarta i zamknięta aplikacja)</p>
              <ul>
                <CvItem entry={usedCvEntry} initialListOpen />
              </ul>
            </div>
            <div class="space-y-1">
              <p class="text-muted-foreground text-xs">default — użycie zwinięte</p>
              <ul>
                <CvItem entry={collapsedCvEntry} />
              </ul>
            </div>
          </div>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <Card className="gap-2 rounded-xl p-4 text-sm shadow-none">
              <p class="text-muted-foreground text-xs">wgrywanie — default</p>
              <CvUploadBox id="ks-cv-upload-default" label={uploadLabel} pending={false} onFile={ignoreFile} />
            </Card>
            <Card className="gap-2 rounded-xl p-4 text-sm shadow-none">
              <p class="text-muted-foreground text-xs">wgrywanie — disabled / loading</p>
              <div>
                <CvUploadBox id="ks-cv-upload-pending" label={uploadLabel} pending onFile={ignoreFile} />
                <CvUploadStatus pending pendingLabel="Wgrywanie…" message={null} error={null} />
              </div>
            </Card>
            <Card className="gap-2 rounded-xl p-4 text-sm shadow-none">
              <p class="text-muted-foreground text-xs">
                wgrywanie — info (plik już w bibliotece; po wgraniu nowego ten sam wiersz potwierdza wgranie)
              </p>
              <div>
                <CvUploadBox id="ks-cv-upload-info" label={uploadLabel} pending={false} onFile={ignoreFile} />
                <CvUploadStatus
                  pending={false}
                  pendingLabel="Wgrywanie…"
                  message={`Ten plik jest już w bibliotece jako „${otherCv.file_name}”.`}
                  error={null}
                />
              </div>
            </Card>
            <Card className="gap-2 rounded-xl p-4 text-sm shadow-none">
              <p class="text-muted-foreground text-xs">wgrywanie — error</p>
              <div>
                <CvUploadBox id="ks-cv-upload-error" label={uploadLabel} pending={false} onFile={ignoreFile} />
                <CvUploadStatus pending={false} pendingLabel="Wgrywanie…" message={null} error={uploadErrorMessage} />
              </div>
            </Card>
          </div>
          {/* The two islands below each render the library's own upload box, so the id "cv-library-upload" appears
              twice on this page (static render, nothing is submitted). */}
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div class="space-y-1">
              <p class="text-muted-foreground text-xs">empty — pusta biblioteka</p>
              <CvLibrary entries={[]} />
            </div>
            <div class="space-y-1">
              <p class="text-muted-foreground text-xs">error — nieudany odczyt (pole wgrywania zostaje)</p>
              {/* Mirrors the failed-read banner of src/pages/cv.astro (page markup, not a component); keep the two
                  in step when it changes. */}
              <Alert variant="destructive" className="mb-4">
                <AlertDescription>
                  <p>
                    Nie udało się wczytać biblioteki CV.{" "}
                    <a
                      href="#ks-cv-library"
                      class="text-link focus-visible:ring-ring inline-flex min-h-10 items-center rounded-sm underline outline-none focus-visible:ring-2"
                    >
                      Odśwież
                    </a>
                  </p>
                </AlertDescription>
              </Alert>
              <CvLibrary entries={null} />
            </div>
          </div>
          <script is:inline define:vars={{ cvMarkers }}>
            for (const [selector, marker] of cvMarkers) {
              document.querySelector(selector)?.setAttribute("data-ks", marker);
            }
          </script>
        </section>

        {/* Islands with sample props (static render; interaction states need the live page). */}
        <section class="space-y-4" data-ks="section-islands">
          <h2 class="font-semibold">Wyspy (render statyczny)</h2>
          <Card className="flex-row flex-wrap items-start gap-6 rounded-xl p-4 shadow-none">
            <div class="space-y-1">
              <p class="text-muted-foreground text-xs">StatusControl — w toku</p>
              <StatusControl applicationId={appId} status="hr_contact" />
            </div>
            <div class="space-y-1">
              <p class="text-muted-foreground text-xs">StatusControl — zamknięta</p>
              <StatusControl applicationId="00000000-0000-4000-8000-000000000002" status="rejected" />
            </div>
            <p class="text-muted-foreground max-w-xs text-xs">
              Stan „Zapisywanie…” i błąd zmiany statusu pojawiają się tylko po interakcji (stan wewnętrzny) — ten sam
              tekst co w sekcji Loading / Alert.
            </p>
          </Card>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div class="space-y-1">
              <p class="text-muted-foreground text-xs">NotesPanel — z notatkami (edytowana, usunięta)</p>
              <NotesPanel applicationId={appId} notes={sampleNotes} />
            </div>
            <div class="space-y-1">
              <p class="text-muted-foreground text-xs">NotesPanel — pusty</p>
              <NotesPanel applicationId="00000000-0000-4000-8000-000000000003" notes={[]} />
            </div>
            <div class="space-y-1">
              <p class="text-muted-foreground text-xs">CvPanel — z bieżącym CV i biblioteką</p>
              <CvPanel applicationId={appId} current={sampleCv} library={[sampleCv, otherCv]} />
            </div>
            <div class="space-y-1">
              <p class="text-muted-foreground text-xs">CvPanel — bez CV, pusta biblioteka</p>
              <CvPanel applicationId="00000000-0000-4000-8000-000000000004" current={null} library={[]} />
            </div>
          </div>
        </section>
      </div>
    </div>
  </Layout>
) : (
  <NotFound />
)}
