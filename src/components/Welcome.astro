---
import Topbar from "@/components/Topbar.astro";
import { History, ListOrdered, PhoneCall } from "lucide-react";

const features = [
  {
    icon: PhoneCall,
    title: "Gotowy na telefon od HR",
    text: "Wpisz firmę, nazwisko rekrutera albo numer — widełki, Twoja stawka i ostatnie ustalenia w kilka sekund, także na telefonie.",
  },
  {
    icon: ListOrdered,
    title: "Najważniejsze na górze",
    text: "Oferty i rozmowy przed wysłanymi CV, zamknięte procesy skreślone na dole. Status zmienia się tylko do przodu.",
  },
  {
    icon: History,
    title: "Nic nie ginie",
    text: "Każda zmiana stawki, statusu i notatki zostawia ślad w historii — wiesz, co i kiedy ustaliłeś.",
  },
];
---

<div class="bg-cosmic relative min-h-screen w-full overflow-hidden">
  <div class="pointer-events-none absolute top-1/4 -left-24 h-[350px] w-[350px] rounded-full bg-purple-500/20 blur-[120px]"></div>
  <div class="pointer-events-none absolute top-2/3 -right-16 h-[250px] w-[250px] rounded-full bg-blue-500/15 blur-[100px]"></div>

  <div class="relative z-10 p-4 sm:p-8">
    <Topbar />

    <div class="mx-auto flex max-w-3xl flex-col items-center px-4 py-20 text-center sm:py-28">
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 via-purple-200 to-pink-200 bg-clip-text text-4xl leading-tight font-bold text-transparent sm:text-6xl">
        Applications Tracker
      </h1>
      <p class="mb-10 max-w-xl text-lg text-blue-100/70">
        Wszystkie Twoje aplikacje o pracę w jednym miejscu: stawki, statusy i ustalenia z rozmów — pod ręką, gdy
        rekruter dzwoni niespodziewanie.
      </p>
      <a
        href="/auth/signin"
        class="inline-flex items-center justify-center rounded-lg bg-purple-600 px-6 py-3 text-base font-medium text-white transition-colors hover:bg-purple-500"
      >
        Zaloguj się
      </a>
    </div>

    <div class="mx-auto grid max-w-4xl grid-cols-1 gap-6 px-4 pb-24 sm:grid-cols-3">
      {features.map(({ icon: Icon, title, text }) => (
        <div class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
          <Icon className="mb-4 size-6 text-purple-300" />
          <h2 class="mb-2 text-lg font-semibold text-white">{title}</h2>
          <p class="text-sm leading-relaxed text-blue-100/60">{text}</p>
        </div>
      ))}
    </div>
  </div>
</div>
