SUPABASE_URL=###
SUPABASE_KEY=###
# Workers Issues → Telegram alerts (POST /api/alerts/issue). Optional locally; production uses `wrangler secret put`.
# ISSUES_WEBHOOK_SECRET must match the Cloudflare webhook secret (header cf-webhook-auth); local smoke uses smoke-webhook-secret.
ISSUES_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Local E2E test user (gitignored .env.e2e, see context/foundation/test-stack.md)
E2E_USERNAME=
E2E_PASSWORD=
# Local Supabase only (npx supabase status: API_URL, SERVICE_ROLE_KEY) — E2E cleanup refuses other hosts
E2E_SUPABASE_URL=
E2E_SUPABASE_SERVICE_ROLE_KEY=
